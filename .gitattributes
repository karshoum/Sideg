# حافظ على نهايات الأسطر الصحيحة لكل نظام تشغيل
# Windows batch files must keep CRLF or `goto` labels can misbehave.
*.bat text eol=crlf

# Unix shell scripts must keep LF or bash fails with "bad interpreter".
*.sh  text eol=lf

*.py  text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.txt text eol=lf

*.js   text eol=lf

# لا تعبث بمحتوى الـ notebooks
*.ipynb -text

# ملفات Office ثنائية — أي تحويل لنهايات الأسطر يُتلفها
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf  binary

# ملف البداية موجّه لقارئ ويندوز: احتفظ بـ CRLF ولا تعبث بالـ BOM
START_HERE.txt -text
